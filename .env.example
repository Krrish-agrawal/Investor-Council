# Copy to .env and fill in. .env is gitignored. Nothing here has a working default password.

# --- MySQL container (docker-compose.yml) ---
COUNCIL_DB_PORT=3307                      # host port, bound to 127.0.0.1 only
MYSQL_ROOT_PASSWORD=                      # required by the container; used as the admin password below

# --- Connection settings used by the `council` CLI ---
COUNCIL_DB_HOST=127.0.0.1
COUNCIL_DB_NAME=investor_council

# Admin account: only used by `council db init` to create the database and users.
COUNCIL_DB_ADMIN_USER=root
COUNCIL_DB_ADMIN_PASSWORD=                # same value as MYSQL_ROOT_PASSWORD

# Human account (full access to the investor_council database). Used by `council human ...`.
COUNCIL_DB_HUMAN_USER=council_human
COUNCIL_DB_HUMAN_PASSWORD=

# Agent account (research tables only, no access to portfolios/holdings). Optional until
# agent tooling is added after kickoff; `council db init` creates it only if a password is set.
COUNCIL_DB_AGENT_USER=council_agent
COUNCIL_DB_AGENT_PASSWORD=

# --- SEC EDGAR (https://www.sec.gov/os/accessing-edgar-data) ---
# SEC asks automated clients to declare who they are: "Name contact@example.com".
# Use YOUR OWN contact details. There is deliberately no default.
COUNCIL_SEC_USER_AGENT=
COUNCIL_SEC_MAX_RPS=5                     # SEC's published ceiling is 10 requests/second

# --- Local data locations (defaults shown) ---
# COUNCIL_DATA_DIR=data
# COUNCIL_FRESHNESS_CONFIG=config/freshness.yaml
# COUNCIL_LOG_LEVEL=INFO
